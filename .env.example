# ===========================================
# Konfigurasi Database — Percetakan Batako Maros
# ===========================================
# Copy file ini menjadi .env dan sesuaikan nilainya:
#   cp .env.example .env
#
# Untuk PRODUCTION (InfinityFree):
#   DB_HOST = sqlXXX.infinityfree.com   (cek di panel MySQL)
#   DB_NAME = epiz_XXXXX_batako_maros    (epiz_XXXXX = account ID)
#   DB_USER = epiz_XXXXX_batako_user
#   DB_PASS = [password database]
#   APP_URL = http://epiz_XXXXX.infinityfreeapp.com
#   APP_ENV = production
#
# Untuk LOKAL (XAMPP):
#   DB_HOST = localhost
#   DB_NAME = db_batako_maros
#   DB_USER = root
#   DB_PASS = (kosongkan)
#   APP_URL = http://localhost/umkm-percetakan-batako
#   APP_ENV = development

DB_HOST=localhost
DB_NAME=db_batako_maros
DB_USER=root
DB_PASS=

# App
APP_URL=http://localhost/umkm-percetakan-batako
APP_NAME=Percetakan Batako Maros
APP_ENV=development
